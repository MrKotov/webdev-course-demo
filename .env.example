# Every environment variable the app reads, with harmless placeholder values.
# Copy to .env for local use. Real values go into Render's settings, never into git.

PORT=3000

# Local and demo: SQLite, a file next to the app.
DATABASE_URL=sqlite:./data/lab-booking.db
# On Render with Neon this becomes a Postgres URL, and src/db.js is the only file that changes:
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Used to sign the session cookie. Generate one: openssl rand -hex 32
SESSION_SECRET=change-me

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# How many upcoming bookings one person may hold.
MAX_ACTIVE_BOOKINGS=3
