# Every environment variable the app reads, with harmless placeholder values.
# Copy to .env for local use. Real values go into Render's settings, never into git.

PORT=3000

# Local and demo: SQLite, a file next to the app.
DATABASE_URL=sqlite:./data/lab-booking.db
# On Render with Neon this becomes a Postgres URL, and src/db.js is the only file that changes:
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Used to sign the session cookie. Generate one: openssl rand -hex 32
SESSION_SECRET=change-me

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# How many upcoming bookings one person may hold.
MAX_ACTIVE_BOOKINGS=3

# --- Sign in with Google -----------------------------------------------------
# The app runs without these: the button then says so instead of failing. Create an
# OAuth client at console.cloud.google.com, leave it in "Testing" mode with yourself
# as a test user (free, no app verification), and register the redirect URI below.
#
# The redirect URI is built from PUBLIC_BASE_URL and must match what Google has,
# character for character: <PUBLIC_BASE_URL>/api/auth/google/callback
# Google requires https for anything that is not localhost, so a codespace's
# forwarded URL and the Render URL both qualify. Register both.
PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- The model feature -------------------------------------------------------
# Free key from aistudio.google.com. Without it the suggestion falls back to the
# app's own rule, which is a supported state and what the tests run against.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash
MODEL_TIMEOUT_MS=8000

# --- The MCP server ----------------------------------------------------------
# An ordinary session token, the same kind POST /api/auth/login puts in a cookie.
# The agent then acts as that person and may do exactly what they may do.
MCP_TOKEN=
